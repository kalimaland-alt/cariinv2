#---------------------------------------------------------------------
# EMAIL / SMTP - untuk lupa password & verifikasi email
# Contoh untuk Gmail (butuh App Password, bukan password biasa):
#   - https://myaccount.google.com/security → 2-Step Verification → App passwords
#   - Generate password 16-digit, paste di mail.SMTPPass
#
# Contoh provider lain:
#   - Mailtrap (testing):  smtp.mailtrap.io, port 2525
#   - SendGrid: smtp.sendgrid.net, port 587, user 'apikey'
#   - Mailgun: smtp.mailgun.org, port 587
#---------------------------------------------------------------------
mail.protocol     = 'smtp'
mail.SMTPHost     = 'smtp.gmail.com'
mail.SMTPPort     = 587
mail.SMTPUser     = 'kalimaland@gmail.com'
mail.SMTPPass     = 'utzipxzgbmwpviqx'
mail.SMTPCrypto   = 'tls'
mail.fromEmail    = 'noreply@carin.id'
mail.fromName     = 'CariIn'

#---------------------------------------------------------------------
# CONTENT SECURITY (jangan diubah kecuali Anda paham)
